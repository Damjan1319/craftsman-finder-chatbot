APP_NAME=Majstori
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sr_RS

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Lokalno: SQLite ---
# DB_CONNECTION=sqlite

# --- Supabase (PostgreSQL) ---
# Dashboard → Project Settings → Database → Connection string → URI
# Za migrate/seed koristi "Direct connection" (port 5432), ne pooler.
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Ili jedna linija (kopiraj URI iz Supabase):
# DATABASE_URL=postgresql://postgres:LOZINKA@db.xxxx.supabase.co:5432/postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME="Majstori Bot"
VIBER_SKIP_SIGNATURE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

META_APP_SECRET=
META_VERIFY_TOKEN=majstori-verify
META_SKIP_SIGNATURE=true
META_GRAPH_VERSION=v21.0

MESSENGER_PAGE_ACCESS_TOKEN=

INSTAGRAM_ACCESS_TOKEN=
